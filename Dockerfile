# берём готовый образ с нужной версией Python
FROM python:3.12-slim

# ставим uv — наш менеджер окружения
RUN pip install uv

# рабочая папка внутри образа
WORKDIR /app

# сначала копируем только объявление зависимостей...
COPY pyproject.toml uv.lock ./
# ...и ставим их строго по lock (этот слой закэшируется)
RUN uv sync --frozen

# теперь копируем остальной код
COPY . .

# сообщаем, что сервис слушает порт 8000
EXPOSE 8000

# команда, которая выполнится при старте контейнера
CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]